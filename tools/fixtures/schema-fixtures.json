{
  "$comment": "T-02 产出的两类东西：(1) 与 DDL 无耦合的**行为 fixtures**（B/C 段用，双驱动测试共用固定数据集，§6.2 第 4/5 步与 §2 目录树对 tools/fixtures 的定位）；(2) **对账引擎自测样本**（A 段漂移样本，证明 diffTable 不是永真断言）。注意：表结构的单一描述源归 T-06 的 packages/shared/src/schema/tables.ts，本文件里的 descriptor 只是格式约定与自测夹具，不得当第二份真相使用（--self-test 会校验形状一致性，T-06 交付后 pnpm ddl-parity 读的是 tables.ts）。",
  "informative_for": "T-06",
  "descriptor_shape": {
    "$comment": "T-06 的 tables.ts 需导出的形状（列名/类型/可空/默认值/索引的单一描述源）",
    "example": [
      {
        "name": "users",
        "columns": [
          { "name": "id", "type": "TEXT", "notNull": true, "primaryKey": true },
          { "name": "phone", "type": "TEXT", "notNull": true },
          { "name": "password", "type": "TEXT", "notNull": false, "default": null },
          { "name": "password_changed_at", "type": "INTEGER", "notNull": true, "default": 0 },
          { "name": "pw_policy_version", "type": "INTEGER", "notNull": true, "default": 0 }
        ],
        "indexes": [{ "name": "idx_users_phone", "columns": ["phone"], "unique": true }]
      }
    ]
  },
  "selftest": {
    "clean_pair": {
      "expected": {
        "name": "t",
        "columns": [
          { "name": "id", "type": "INTEGER", "notNull": true },
          { "name": "data", "type": "TEXT", "notNull": true, "default": "[]" }
        ],
        "indexes": [{ "name": "i1", "columns": ["id"], "unique": false }]
      },
      "actual": {
        "columns": [
          { "name": "id", "type": "INTEGER", "notNull": true, "default": null },
          { "name": "data", "type": "TEXT", "notNull": true, "default": "'[]'" }
        ],
        "indexes": [{ "name": "whatever", "columns": ["id"], "unique": false }]
      }
    },
    "A_cases": [
      {
        "id": "缺列",
        "expect_diff": "column-missing",
        "expected": { "columns": [{ "name": "a", "type": "TEXT", "notNull": true }, { "name": "b", "type": "TEXT", "notNull": false }], "indexes": [] },
        "actual": { "columns": [{ "name": "a", "type": "TEXT", "notNull": true }], "indexes": [] }
      },
      {
        "id": "多列",
        "expect_diff": "column-extra",
        "expected": { "columns": [{ "name": "a", "type": "TEXT", "notNull": true }], "indexes": [] },
        "actual": { "columns": [{ "name": "a", "type": "TEXT", "notNull": true }, { "name": "ghost", "type": "TEXT", "notNull": false }], "indexes": [] }
      },
      {
        "id": "类型漂移（pg VARCHAR vs sqlite TEXT 不算漂移，TEXT vs INTEGER 才算）",
        "expect_diff": "type-mismatch",
        "driver": "pg",
        "expected": { "columns": [{ "name": "phone", "type": "varchar(11)", "notNull": true }], "indexes": [] },
        "actual": { "columns": [{ "name": "phone", "type": "integer", "notNull": true }], "indexes": [] }
      },
      {
        "id": "NOT NULL 漂移",
        "expect_diff": "notnull-mismatch",
        "expected": { "columns": [{ "name": "sync_version", "type": "INTEGER", "notNull": true, "default": 0 }], "indexes": [] },
        "actual": { "columns": [{ "name": "sync_version", "type": "INTEGER", "notNull": false, "default": 0 }], "indexes": [] }
      },
      {
        "id": "默认值漂移",
        "expect_diff": "default-mismatch",
        "expected": { "columns": [{ "name": "tombstones", "type": "TEXT", "notNull": true, "default": "[]" }], "indexes": [] },
        "actual": { "columns": [{ "name": "tombstones", "type": "TEXT", "notNull": true, "default": null }], "indexes": [] }
      },
      {
        "id": "缺索引",
        "expect_diff": "index-missing",
        "expected": { "columns": [{ "name": "user_id", "type": "INTEGER", "notNull": true }], "indexes": [{ "name": "ix1", "columns": ["user_id", "created_at"], "unique": false }] },
        "actual": { "columns": [{ "name": "user_id", "type": "INTEGER", "notNull": true }, { "name": "created_at", "type": "INTEGER", "notNull": true }], "indexes": [] }
      },
      {
        "id": "多索引",
        "expect_diff": "index-extra",
        "expected": { "columns": [{ "name": "user_id", "type": "INTEGER", "notNull": true }], "indexes": [] },
        "actual": { "columns": [{ "name": "user_id", "type": "INTEGER", "notNull": true }], "indexes": [{ "name": "surprise", "columns": ["user_id"], "unique": true }] }
      }
    ]
  },
