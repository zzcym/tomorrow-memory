# ===== 明日记忆 环境变量模板 =====
# 复制为 .env 后填写实际值：cp .env.example .env（Windows: copy .env.example .env）

# ---- 服务 ----
# 服务端口
PORT=3001
# 数据文件目录（前端静态文件、词典文件所在目录；默认 monorepo 根目录）
DATA_DIR=

# ---- 数据库 ----
# 驱动: pg | sqlite
DB_DRIVER=pg
# PostgreSQL 连接串（DB_DRIVER=pg 时使用）
DATABASE_URL=postgresql://tm_user:tm_pass_2024@localhost:5432/tomorrow_memory
# SQLite 数据文件路径（DB_DRIVER=sqlite 时使用）
SQLITE_PATH=

# ---- 安全 ----
# JWT 密钥（必填！生产环境请使用强随机值: openssl rand -hex 32）
JWT_SECRET=dev-secret-change-me
# 管理后台密码
ADMIN_PASSWORD=admin888

# ---- 词典/翻译 API ----
# 有道翻译（http://ai.youdao.com 申请）
YOUDAO_APP_KEY=115fb00277c7315b
YOUDAO_SECRET=EI7VnZNuHkft9z9ihlVXnInCV09Kjc7D

# ---- LLM（Phase 2 使用）----
# DeepSeek（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Embedding 模型（Phase 2 使用）----
# 默认 OpenAI text-embedding-3-small；可换任何 OpenAI 兼容 embedding 服务
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com
EMBEDDING_MODEL=text-embedding-3-small

# ---- 向量数据库 ----
QDRANT_URL=http://localhost:6333

# ---- 缓存 ----
REDIS_URL=redis://localhost:6379

# ---- 词典文件路径（留空使用 DATA_DIR 下默认文件名）----
DICT_DB_PATH=
EXAMPLES_DB_PATH=
EC_DICT_PATH=
