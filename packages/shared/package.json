{
  "name": "@tm/shared",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./utils": "./src/utils.ts",
    "./copy": "./src/copy.ts",
    "./constants": "./src/constants/index.ts",
    "./constants/*": "./src/constants/*.ts",
    "./schema": "./src/schema/tables.ts",
    "./schema/*": "./src/schema/*.ts",
