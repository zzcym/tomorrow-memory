    "./contracts/*": "./src/contracts/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --project @tm/shared"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
